generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  MANAGER
  STAFF
}

enum ResellerAuthType {
  API_KEY
  BEARER
}

enum MarkupType {
  FIXED
  PERCENTAGE
}

enum ProductType {
  PHYSICAL
  DIGITAL
}

enum DigitalAssetType {
  DOWNLOAD
  LICENSE_KEY
}

enum StockAdjustmentType {
  OPENING
  RECEIVE
  DAMAGE
  LOSS
  RETURN
  CORRECTION
  RESELLER_SYNC
  ORDER_RESERVED
  ORDER_RELEASED
  TRANSFER_IN
  TRANSFER_OUT
}

enum DeliveryZone {
  DHAKA
  CHATTOGRAM
  REST_OF_BANGLADESH
}

enum OrderStatus {
  PENDING
  AWAITING_PAYMENT
  CONFIRMED
  PROCESSING
  PACKED
  SHIPPED
  DELIVERED
  RETURNED
  CANCELLED
}

enum PaymentMethod {
  COD
  CASH
  BKASH
  NAGAD
  SSLCOMMERZ
}

enum PaymentState {
  PENDING
  SUCCEEDED
  FAILED
}

enum OfferDiscountType {
  FIXED
  PERCENTAGE
}

enum OrderSource {
  WEB
  FACEBOOK
  PHONE
  POS
}

enum CourierProvider {
  STEADFAST
  PATHAO
  REDX
}

enum CourierBookingStatus {
  PENDING
  BOOKED
  FAILED
  IN_TRANSIT
  DELIVERED
  RETURNED
  CANCELLED
}

enum PurchaseOrderStatus {
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum FraudRiskLevel {
  LOW
  MEDIUM
  HIGH
  UNKNOWN
}

enum FinancialAccountType {
  CASH
  BANK
  MOBILE_WALLET
  OTHER
}

enum AccountingCategoryType {
  INCOME
  EXPENSE
}

enum AccountingTransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum PayrollStatus {
  DRAFT
  PAID
}

enum CourierSettlementStatus {
  PENDING
  RECONCILED
}

model User {
  id                 String                  @id @default(cuid())
  name               String
  email              String                  @unique
  passwordHash       String                  @map("password_hash")
  role               UserRole                @default(STAFF)
  isActive           Boolean                 @default(true) @map("is_active")
  createdAt          DateTime                @default(now()) @map("created_at")
  updatedAt          DateTime                @updatedAt @map("updated_at")
  stockAdjustments   StockAdjustment[]
  stockTransfers     StockTransfer[]
  ordersCreated      Order[]                 @relation("OrderCreatedBy")
  orderNotes         OrderNote[]
  orderStatusChanges OrderStatusHistory[]
  purchaseOrders     PurchaseOrder[]         @relation("PurchaseCreatedBy")
  fraudChecks        FraudCheck[]
  activityLogs       ActivityLog[]
  accountingEntries  AccountingTransaction[] @relation("AccountingCreatedBy")
  payrollRecords     PayrollRecord[]         @relation("PayrollEmployee")
  payrollCreated     PayrollRecord[]         @relation("PayrollCreatedBy")
  courierSettlements CourierSettlement[]     @relation("CourierSettlementCreatedBy")

  @@index([role, isActive])
  @@map("users")
}

model GeneralSettings {
  id                   String   @id @default("store")
  storeName            String   @map("store_name")
  tagline              String
  orderNumberPrefix    String   @default("1001") @map("order_number_prefix")
  currencyCode         String   @default("BDT") @map("currency_code") @db.VarChar(3)
  currencySymbol       String   @default("৳") @map("currency_symbol")
  contactEmail         String?  @map("contact_email")
  contactPhone         String?  @map("contact_phone")
  contactAddress       String?  @map("contact_address") @db.Text
  themePrimaryColor    String   @default("#176b48") @map("theme_primary_color") @db.VarChar(7)
  themeAccentColor     String   @default("#a6edbb") @map("theme_accent_color") @db.VarChar(7)
  announcementText     String   @default("Everything you need, at crazy speed.") @map("announcement_text") @db.VarChar(240)
  homeHeroTitle        String   @default("Crazy Cart") @map("home_hero_title") @db.VarChar(180)
  homeHeroDescription  String   @default("Everything you need, at crazy speed.") @map("home_hero_description") @db.Text
  footerMessage        String   @default("আপনার প্রতিদিনের কেনাকাটার নির্ভরযোগ্য ঠিকানা।") @map("footer_message") @db.Text
  autoMoveToPending    Boolean  @default(true) @map("auto_move_to_pending")
  freeDeliveryAboveBDT Decimal? @map("free_delivery_above_bdt") @db.Decimal(12, 2)
  nextOrderSequence    Int      @default(0) @map("next_order_sequence")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("general_settings")
}

model ResellerSource {
  id              String           @id @default(cuid())
  name            String           @unique
  baseUrl         String           @map("base_url") @db.VarChar(2048)
  authType        ResellerAuthType @map("auth_type")
  encryptedApiKey String           @map("encrypted_api_key") @db.Text
  markupType      MarkupType       @default(FIXED) @map("markup_type")
  markupValue     Decimal          @default(0) @map("markup_value") @db.Decimal(12, 2)
  lastSyncedAt    DateTime?        @map("last_synced_at")
  isActive        Boolean          @default(true) @map("is_active")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  products        Product[]
  productImages   ProductImage[]

  @@index([isActive])
  @@map("reseller_sources")
}

model Category {
  id          String     @id @default(cuid())
  name        String     @unique
  slug        String     @unique
  description String?    @db.Text
  parentId    String?    @map("parent_id")
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryTree")
  products    Product[]
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  @@index([parentId])
  @@map("categories")
}

model Brand {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?   @db.Text
  products    Product[]
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("brands")
}

model Product {
  id                   String           @id @default(cuid())
  name                 String           @db.VarChar(180)
  slug                 String           @unique @db.VarChar(200)
  description          String?          @db.Text
  type                 ProductType      @default(PHYSICAL)
  price                Decimal          @default(0) @db.Decimal(12, 2)
  currencyCode         String           @default("BDT") @map("currency_code") @db.VarChar(3)
  categoryId           String?          @map("category_id")
  brandId              String?          @map("brand_id")
  externalSourceId     String?          @map("external_source_id")
  externalProductId    String?          @map("external_product_id")
  supplierPrice        Decimal?         @map("supplier_price") @db.Decimal(12, 2)
  isResellerProduct    Boolean          @default(false) @map("is_reseller_product")
  lastResellerSyncedAt DateTime?        @map("last_reseller_synced_at")
  isActive             Boolean          @default(true) @map("is_active")
  allowPreorder        Boolean          @default(false) @map("allow_preorder")
  weightGrams          Int              @default(500) @map("weight_grams")
  sizeGuide            String?          @map("size_guide") @db.Text
  shippingClassId      String?          @map("shipping_class_id")
  category             Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brand                Brand?           @relation(fields: [brandId], references: [id], onDelete: SetNull)
  externalSource       ResellerSource?  @relation(fields: [externalSourceId], references: [id], onDelete: SetNull)
  shippingClass        ShippingClass?   @relation(fields: [shippingClassId], references: [id], onDelete: SetNull)
  variants             ProductVariant[]
  images               ProductImage[]
  digitalAssets        DigitalAsset[]
  reviews              ProductReview[]
  orderItems           OrderItem[]
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  @@unique([externalSourceId, externalProductId])
  @@index([categoryId])
  @@index([brandId])
  @@index([isResellerProduct, isActive])
  @@index([shippingClassId])
  @@map("products")
}

model ProductVariant {
  id                 String              @id @default(cuid())
  productId          String              @map("product_id")
  name               String?             @db.VarChar(120)
  sku                String              @unique @db.VarChar(120)
  externalSku        String?             @map("external_sku") @db.VarChar(120)
  size               String?             @db.VarChar(80)
  color              String?             @db.VarChar(80)
  price              Decimal             @db.Decimal(12, 2)
  stockOnHand        Int                 @default(0) @map("stock_on_hand")
  externalVariantId  String?             @map("external_variant_id") @db.VarChar(180)
  isActive           Boolean             @default(true) @map("is_active")
  product            Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventoryBatches   InventoryBatch[]
  adjustments        StockAdjustment[]
  transfers          StockTransfer[]
  digitalAssets      DigitalAsset[]
  orderItems         OrderItem[]
  purchaseOrderItems PurchaseOrderItem[]
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  @@unique([productId, externalVariantId])
  @@index([productId, isActive])
  @@map("product_variants")
}

model ProductImage {
  id               String          @id @default(cuid())
  productId        String          @map("product_id")
  externalSourceId String?         @map("external_source_id")
  url              String          @db.VarChar(2048)
  altText          String          @map("alt_text") @db.VarChar(250)
  sortOrder        Int             @default(0) @map("sort_order")
  product          Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  externalSource   ResellerSource? @relation(fields: [externalSourceId], references: [id], onDelete: SetNull)
  createdAt        DateTime        @default(now()) @map("created_at")

  @@unique([productId, url])
  @@index([externalSourceId])
  @@index([productId, sortOrder])
  @@map("product_images")
}

model DigitalAsset {
  id                String                  @id @default(cuid())
  productId         String                  @map("product_id")
  variantId         String?                 @map("variant_id")
  type              DigitalAssetType
  label             String                  @db.VarChar(180)
  fileName          String?                 @map("file_name") @db.VarChar(255)
  downloadUrl       String?                 @map("download_url") @db.VarChar(2048)
  encryptedValue    String?                 @map("encrypted_value") @db.Text
  secretFingerprint String?                 @unique @map("secret_fingerprint") @db.VarChar(64)
  isAvailable       Boolean                 @default(true) @map("is_available")
  product           Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant           ProductVariant?         @relation(fields: [variantId], references: [id], onDelete: SetNull)
  orderAssignments  OrderItemDigitalAsset[]
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")

  @@index([productId, type, isAvailable])
  @@map("digital_assets")
}

model Warehouse {
  id                String            @id @default(cuid())
  name              String            @unique
  code              String            @unique @db.VarChar(40)
  isActive          Boolean           @default(true) @map("is_active")
  inventoryBatches  InventoryBatch[]
  adjustments       StockAdjustment[]
  outgoingTransfers StockTransfer[]   @relation("TransferFromWarehouse")
  incomingTransfers StockTransfer[]   @relation("TransferToWarehouse")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  @@map("warehouses")
}

model InventoryBatch {
  id                       String               @id @default(cuid())
  variantId                String               @map("variant_id")
  warehouseId              String               @map("warehouse_id")
  batchCode                String?              @map("batch_code") @db.VarChar(120)
  quantityReceived         Int                  @map("quantity_received")
  quantityRemaining        Int                  @map("quantity_remaining")
  unitCost                 Decimal              @map("unit_cost") @db.Decimal(12, 2)
  purchaseOrderItemId      String?              @map("purchase_order_item_id")
  receivedAt               DateTime             @default(now()) @map("received_at")
  variant                  ProductVariant       @relation(fields: [variantId], references: [id], onDelete: Restrict)
  warehouse                Warehouse            @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  adjustments              StockAdjustment[]
  sourceTransferLines      StockTransferBatch[] @relation("TransferSourceBatch")
  destinationTransferLines StockTransferBatch[] @relation("TransferDestinationBatch")
  orderReservations        OrderItemBatch[]
  purchaseOrderItem        PurchaseOrderItem?   @relation(fields: [purchaseOrderItemId], references: [id], onDelete: SetNull)
  createdAt                DateTime             @default(now()) @map("created_at")

  @@index([variantId, warehouseId, receivedAt, id])
  @@map("inventory_batches")
}

model StockAdjustment {
  id             String              @id @default(cuid())
  variantId      String              @map("variant_id")
  warehouseId    String              @map("warehouse_id")
  batchId        String?             @map("batch_id")
  createdById    String?             @map("created_by_id")
  type           StockAdjustmentType
  quantityChange Int                 @map("quantity_change")
  note           String?             @db.Text
  variant        ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Restrict)
  warehouse      Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  batch          InventoryBatch?     @relation(fields: [batchId], references: [id], onDelete: SetNull)
  createdBy      User?               @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt      DateTime            @default(now()) @map("created_at")

  @@index([variantId, createdAt])
  @@index([warehouseId, createdAt])
  @@map("stock_adjustments")
}

model StockTransfer {
  id              String               @id @default(cuid())
  variantId       String               @map("variant_id")
  fromWarehouseId String               @map("from_warehouse_id")
  toWarehouseId   String               @map("to_warehouse_id")
  createdById     String               @map("created_by_id")
  quantity        Int
  note            String?              @db.Text
  variant         ProductVariant       @relation(fields: [variantId], references: [id], onDelete: Restrict)
  fromWarehouse   Warehouse            @relation("TransferFromWarehouse", fields: [fromWarehouseId], references: [id], onDelete: Restrict)
  toWarehouse     Warehouse            @relation("TransferToWarehouse", fields: [toWarehouseId], references: [id], onDelete: Restrict)
  createdBy       User                 @relation(fields: [createdById], references: [id], onDelete: Restrict)
  batches         StockTransferBatch[]
  createdAt       DateTime             @default(now()) @map("created_at")

  @@index([variantId, createdAt])
  @@map("stock_transfers")
}

model StockTransferBatch {
  id                 String         @id @default(cuid())
  transferId         String         @map("transfer_id")
  sourceBatchId      String         @map("source_batch_id")
  destinationBatchId String         @map("destination_batch_id")
  quantity           Int
  transfer           StockTransfer  @relation(fields: [transferId], references: [id], onDelete: Cascade)
  sourceBatch        InventoryBatch @relation("TransferSourceBatch", fields: [sourceBatchId], references: [id], onDelete: Restrict)
  destinationBatch   InventoryBatch @relation("TransferDestinationBatch", fields: [destinationBatchId], references: [id], onDelete: Restrict)

  @@unique([transferId, sourceBatchId, destinationBatchId])
  @@map("stock_transfer_batches")
}

model ShippingClass {
  id        String    @id @default(cuid())
  code      String    @unique @db.VarChar(40)
  name      String    @db.VarChar(80)
  surcharge Decimal   @default(0) @db.Decimal(12, 2)
  isActive  Boolean   @default(true) @map("is_active")
  products  Product[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("shipping_classes")
}

model DeliveryRate {
  id                  String       @id @default(cuid())
  zone                DeliveryZone @unique
  baseCharge          Decimal      @map("base_charge") @db.Decimal(12, 2)
  includedWeightGrams Int          @default(1000) @map("included_weight_grams")
  extraPerKgCharge    Decimal      @map("extra_per_kg_charge") @db.Decimal(12, 2)
  isActive            Boolean      @default(true) @map("is_active")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  @@map("delivery_rates")
}

model Offer {
  id            String             @id @default(cuid())
  title         String             @db.VarChar(180)
  description   String             @db.Text
  promoCode     String?            @unique @map("promo_code") @db.VarChar(60)
  discountType  OfferDiscountType? @map("discount_type")
  discountValue Decimal?           @map("discount_value") @db.Decimal(12, 2)
  startsAt      DateTime?          @map("starts_at")
  endsAt        DateTime?          @map("ends_at")
  isActive      Boolean            @default(false) @map("is_active")
  showPopup     Boolean            @default(false) @map("show_popup")
  orders        Order[]
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  @@index([isActive, startsAt, endsAt])
  @@map("offers")
}

model ProductReview {
  id           String   @id @default(cuid())
  productId    String   @map("product_id")
  customerName String   @map("customer_name") @db.VarChar(120)
  rating       Int
  title        String?  @db.VarChar(180)
  body         String   @db.Text
  isApproved   Boolean  @default(false) @map("is_approved")
  createdAt    DateTime @default(now()) @map("created_at")
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, isApproved, createdAt])
  @@map("product_reviews")
}

model Order {
  id               String               @id @default(cuid())
  orderNumber      String               @unique @map("order_number") @db.VarChar(80)
  status           OrderStatus          @default(PENDING)
  paymentMethod    PaymentMethod        @map("payment_method")
  paymentState     PaymentState         @default(PENDING) @map("payment_state")
  customerName     String               @map("customer_name") @db.VarChar(160)
  customerPhone    String               @map("customer_phone") @db.VarChar(40)
  customerEmail    String?              @map("customer_email") @db.VarChar(254)
  address          String               @db.Text
  area             String?              @db.VarChar(120)
  city             String               @db.VarChar(120)
  deliveryZone     DeliveryZone?        @map("delivery_zone")
  subtotal         Decimal              @db.Decimal(12, 2)
  shippingCharge   Decimal              @default(0) @map("shipping_charge") @db.Decimal(12, 2)
  total            Decimal              @db.Decimal(12, 2)
  currencyCode     String               @default("BDT") @map("currency_code") @db.VarChar(3)
  hasPreorder      Boolean              @default(false) @map("has_preorder")
  items            OrderItem[]
  paymentAttempts  PaymentAttempt[]
  offer            Offer?               @relation(fields: [offerId], references: [id], onDelete: SetNull)
  offerId          String?              @map("offer_id")
  appliedPromoCode String?              @map("applied_promo_code") @db.VarChar(60)
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")
  discountAmount   Decimal              @default(0) @map("discount_amount") @db.Decimal(12, 2)
  customerId       String?              @map("customer_id")
  source           OrderSource          @default(WEB)
  idempotencyKey   String?              @unique @map("idempotency_key") @db.VarChar(120)
  createdById      String?              @map("created_by_id")
  customer         Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdBy        User?                @relation("OrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  notes            OrderNote[]
  statusHistory    OrderStatusHistory[]
  courierBookings  CourierBooking[]
  fraudChecks      FraudCheck[]

  @@index([status, createdAt])
  @@index([customerPhone, createdAt])
  @@index([source, createdAt])
  @@index([customerId, createdAt])
  @@map("orders")
}

model OrderItem {
  id               String                  @id @default(cuid())
  orderId          String                  @map("order_id")
  productId        String                  @map("product_id")
  variantId        String                  @map("variant_id")
  productName      String                  @map("product_name") @db.VarChar(180)
  sku              String                  @db.VarChar(120)
  quantity         Int
  reservedQuantity Int                     @default(0) @map("reserved_quantity")
  unitPrice        Decimal                 @map("unit_price") @db.Decimal(12, 2)
  lineTotal        Decimal                 @map("line_total") @db.Decimal(12, 2)
  weightGrams      Int                     @map("weight_grams")
  isPreorder       Boolean                 @default(false) @map("is_preorder")
  order            Order                   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product          Product                 @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant          ProductVariant          @relation(fields: [variantId], references: [id], onDelete: Restrict)
  batches          OrderItemBatch[]
  digitalAssets    OrderItemDigitalAsset[]
  createdAt        DateTime                @default(now()) @map("created_at")

  @@index([orderId])
  @@map("order_items")
}

model OrderItemBatch {
  id          String         @id @default(cuid())
  orderItemId String         @map("order_item_id")
  batchId     String         @map("batch_id")
  quantity    Int
  orderItem   OrderItem      @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  batch       InventoryBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@unique([orderItemId, batchId])
  @@map("order_item_batches")
}

model OrderItemDigitalAsset {
  id          String       @id @default(cuid())
  orderItemId String       @map("order_item_id")
  assetId     String       @unique @map("asset_id")
  orderItem   OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  asset       DigitalAsset @relation(fields: [assetId], references: [id], onDelete: Restrict)
  createdAt   DateTime     @default(now()) @map("created_at")

  @@index([orderItemId])
  @@map("order_item_digital_assets")
}

model PaymentAttempt {
  id             String        @id @default(cuid())
  orderId        String        @map("order_id")
  method         PaymentMethod
  state          PaymentState  @default(PENDING)
  amount         Decimal       @db.Decimal(12, 2)
  providerRef    String?       @map("provider_ref") @db.VarChar(160)
  idempotencyKey String        @unique @map("idempotency_key") @db.VarChar(120)
  order          Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  @@index([orderId, createdAt])
  @@map("payment_attempts")
}

model Customer {
  id                 String    @id @default(cuid())
  name               String    @db.VarChar(160)
  phone              String    @unique @db.VarChar(40)
  email              String?   @db.VarChar(254)
  marketingConsent   Boolean   @default(false) @map("marketing_consent")
  marketingConsentAt DateTime? @map("marketing_consent_at")
  orders             Order[]
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@map("customers")
}

model OrderNote {
  id        String   @id @default(cuid())
  orderId   String   @map("order_id")
  authorId  String?  @map("author_id")
  body      String   @db.Text
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([orderId, createdAt])
  @@map("order_notes")
}

model OrderStatusHistory {
  id         String       @id @default(cuid())
  orderId    String       @map("order_id")
  authorId   String?      @map("author_id")
  fromStatus OrderStatus? @map("from_status")
  toStatus   OrderStatus  @map("to_status")
  note       String?      @db.Text
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  author     User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt  DateTime     @default(now()) @map("created_at")

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

model CourierProviderSetting {
  id                   String          @id @default(cuid())
  provider             CourierProvider @unique
  encryptedCredentials String          @map("encrypted_credentials") @db.Text
  isActive             Boolean         @default(false) @map("is_active")
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")

  @@map("courier_provider_settings")
}

model CourierBooking {
  id             String               @id @default(cuid())
  orderId        String               @map("order_id")
  provider       CourierProvider
  status         CourierBookingStatus @default(PENDING)
  trackingNumber String?              @map("tracking_number") @db.VarChar(180)
  consignmentId  String?              @map("consignment_id") @db.VarChar(180)
  idempotencyKey String               @unique @map("idempotency_key") @db.VarChar(120)
  errorMessage   String?              @map("error_message") @db.Text
  bookedAt       DateTime?            @map("booked_at")
  order          Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  settlement     CourierSettlement?
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  @@unique([orderId, provider])
  @@index([provider, status, createdAt])
  @@map("courier_bookings")
}

model FraudCheck {
  id          String         @id @default(cuid())
  orderId     String         @map("order_id")
  provider    String         @db.VarChar(80)
  riskLevel   FraudRiskLevel @map("risk_level")
  summary     String         @db.Text
  externalRef String?        @map("external_ref") @db.VarChar(180)
  checkedById String?        @map("checked_by_id")
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  checkedBy   User?          @relation(fields: [checkedById], references: [id], onDelete: SetNull)
  createdAt   DateTime       @default(now()) @map("created_at")

  @@index([orderId, createdAt])
  @@map("fraud_checks")
}

model Supplier {
  id             String          @id @default(cuid())
  name           String          @unique @db.VarChar(160)
  phone          String?         @db.VarChar(40)
  email          String?         @db.VarChar(254)
  address        String?         @db.Text
  isActive       Boolean         @default(true) @map("is_active")
  purchaseOrders PurchaseOrder[]
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  @@map("suppliers")
}

model PurchaseOrder {
  id          String              @id @default(cuid())
  supplierId  String              @map("supplier_id")
  createdById String              @map("created_by_id")
  status      PurchaseOrderStatus @default(ORDERED)
  note        String?             @db.Text
  supplier    Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy   User                @relation("PurchaseCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  items       PurchaseOrderItem[]
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([supplierId, createdAt])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String           @id @default(cuid())
  purchaseOrderId  String           @map("purchase_order_id")
  variantId        String           @map("variant_id")
  quantityOrdered  Int              @map("quantity_ordered")
  quantityReceived Int              @default(0) @map("quantity_received")
  unitCost         Decimal          @map("unit_cost") @db.Decimal(12, 2)
  purchaseOrder    PurchaseOrder    @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  variant          ProductVariant   @relation(fields: [variantId], references: [id], onDelete: Restrict)
  inventoryBatches InventoryBatch[]
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  @@index([purchaseOrderId])
  @@map("purchase_order_items")
}

model FinancialAccount {
  id                 String                  @id @default(cuid())
  name               String                  @db.VarChar(120)
  type               FinancialAccountType
  provider           String?                 @db.VarChar(80)
  accountReference   String?                 @map("account_reference") @db.VarChar(80)
  openingBalance     Decimal                 @default(0) @map("opening_balance") @db.Decimal(12, 2)
  isActive           Boolean                 @default(true) @map("is_active")
  transactions       AccountingTransaction[] @relation("TransactionAccount")
  destinationMoves   AccountingTransaction[] @relation("TransactionDestination")
  courierSettlements CourierSettlement[]
  createdAt          DateTime                @default(now()) @map("created_at")
  updatedAt          DateTime                @updatedAt @map("updated_at")

  @@unique([name])
  @@index([isActive, type])
  @@map("financial_accounts")
}

model AccountingCategory {
  id           String                  @id @default(cuid())
  name         String                  @db.VarChar(100)
  type         AccountingCategoryType
  isActive     Boolean                 @default(true) @map("is_active")
  transactions AccountingTransaction[]
  createdAt    DateTime                @default(now()) @map("created_at")
  updatedAt    DateTime                @updatedAt @map("updated_at")

  @@unique([name, type])
  @@index([type, isActive])
  @@map("accounting_categories")
}

model AccountingTransaction {
  id                   String                    @id @default(cuid())
  type                 AccountingTransactionType
  amount               Decimal                   @db.Decimal(12, 2)
  description          String                    @db.Text
  occurredAt           DateTime                  @default(now()) @map("occurred_at")
  accountId            String                    @map("account_id")
  destinationAccountId String?                   @map("destination_account_id")
  categoryId           String?                   @map("category_id")
  createdById          String?                   @map("created_by_id")
  courierSettlementId  String?                   @map("courier_settlement_id")
  account              FinancialAccount          @relation("TransactionAccount", fields: [accountId], references: [id], onDelete: Restrict)
  destinationAccount   FinancialAccount?         @relation("TransactionDestination", fields: [destinationAccountId], references: [id], onDelete: Restrict)
  category             AccountingCategory?       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdBy            User?                     @relation("AccountingCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  courierSettlement    CourierSettlement?        @relation(fields: [courierSettlementId], references: [id], onDelete: Restrict)
  payrollRecord        PayrollRecord?
  createdAt            DateTime                  @default(now()) @map("created_at")

  @@index([occurredAt, type])
  @@index([accountId, occurredAt])
  @@index([categoryId, occurredAt])
  @@index([courierSettlementId])
  @@map("accounting_transactions")
}

model PayrollRecord {
  id            String                 @id @default(cuid())
  employeeId    String                 @map("employee_id")
  createdById   String                 @map("created_by_id")
  period        String                 @db.VarChar(7)
  baseSalary    Decimal                @map("base_salary") @db.Decimal(12, 2)
  allowances    Decimal                @default(0) @db.Decimal(12, 2)
  deductions    Decimal                @default(0) @db.Decimal(12, 2)
  netPay        Decimal                @map("net_pay") @db.Decimal(12, 2)
  status        PayrollStatus          @default(DRAFT)
  paidAt        DateTime?              @map("paid_at")
  transactionId String?                @unique @map("transaction_id")
  employee      User                   @relation("PayrollEmployee", fields: [employeeId], references: [id], onDelete: Restrict)
  createdBy     User                   @relation("PayrollCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  transaction   AccountingTransaction? @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")

  @@unique([employeeId, period])
  @@index([period, status])
  @@map("payroll_records")
}

model CourierSettlement {
  id               String                  @id @default(cuid())
  bookingId        String                  @unique @map("booking_id")
  accountId        String                  @map("account_id")
  createdById      String                  @map("created_by_id")
  expectedCod      Decimal                 @map("expected_cod") @db.Decimal(12, 2)
  receivedAmount   Decimal                 @map("received_amount") @db.Decimal(12, 2)
  courierFee       Decimal                 @default(0) @map("courier_fee") @db.Decimal(12, 2)
  status           CourierSettlementStatus @default(PENDING)
  paymentReference String?                 @map("payment_reference") @db.VarChar(160)
  reconciledAt     DateTime?               @map("reconciled_at")
  booking          CourierBooking          @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  account          FinancialAccount        @relation(fields: [accountId], references: [id], onDelete: Restrict)
  createdBy        User                    @relation("CourierSettlementCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  transactions     AccountingTransaction[]
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@map("courier_settlements")
}

model ActivityLog {
  id         String   @id @default(cuid())
  actorId    String?  @map("actor_id")
  action     String   @db.VarChar(80)
  entityType String   @map("entity_type") @db.VarChar(80)
  entityId   String   @map("entity_id") @db.VarChar(120)
  summary    String   @db.Text
  details    Json?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@map("activity_logs")
}
